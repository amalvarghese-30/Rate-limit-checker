# Rate Limit Checker Environment Configuration

# Server Bind Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Security & SSRF Protection
# Set to false in production to prevent probing private VPC, localhost, or cloud metadata endpoints.
# Set to true only in local development when testing against local mock servers (127.0.0.1).
ALLOW_LOCAL_TARGETS=false

# Job & Resource Concurrency
MAX_CONCURRENT_JOBS=5
DEFAULT_TIMEOUT_SEC=10.0
MAX_ANALYSIS_DURATION_SEC=60.0
MAX_RESPONSE_BODY_BYTES=65536

# Database Path (defaults to data/history.db)
DATABASE_PATH=data/history.db

# Optional Authentication for Public / Internet-Facing Deployments
# When set, requires 'X-API-Key: <key>' or 'Authorization: Bearer <key>' on write endpoints.
# API_KEY=replace_with_a_secure_random_key
